# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/cinemalik"

# JWT secrets — use two different long random values (e.g. `openssl rand -hex 32`)
ACCESS_TOKEN=""
REFRESH_TOKEN=""

# TMDB API key — https://www.themoviedb.org/settings/api
MOVIES_API_KEY=""

# API port (optional, defaults to 3000)
PORT=3000

# Set to "production" to send the refresh cookie over HTTPS only
NODE_ENV=development
